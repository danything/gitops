{
  // 型の検査だけに使う(bun run typecheck)。実行は bun が .ts を直接走らせる(Pulumi も bun ランタイム)
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["index.ts", "report.ts"]
}
