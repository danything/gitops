        "getAgentNetworkPolicy.ts",
        "getAgentNetworkProvider.ts",
        "getDnsRecord.ts",
        "getDnsSettings.ts",
        "getDnsZone.ts",
        "getGroup.ts",
        "getIdentityProvider.ts",
        "getNameserverGroup.ts",
        "getNetwork.ts",
        "getNetworkResource.ts",
        "getNetworkRouter.ts",
        "getPeer.ts",
        "getPeers.ts",
        "getPolicy.ts",
        "getPostureCheck.ts",
        "getReverseProxyClusters.ts",
        "getReverseProxyDomain.ts",
