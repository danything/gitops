{
  // 型の検査だけに使う(npm run typecheck)。実行は Node が .ts から型を剥がして走らせる
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    // Node の型の剥がし方で動く書き方だけに絞る(enum・namespace・引数プロパティは不可)
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["drift.ts"]
}
