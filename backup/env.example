# /etc/k3s-backup/env (root:root 600)
# ここが「手で持つ唯一の秘密」。パスワードマネージャに同じ内容を置き、オフラインにも 1 部。

# Cloudflare R2 の例。B2 なら s3:https://s3.<region>.backblazeb2.com/<bucket>
RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>
RESTIC_PASSWORD=<長いパスフレーズ>
AWS_ACCESS_KEY_ID=<access key>
AWS_SECRET_ACCESS_KEY=<secret key>
# R2 は region を "auto" にしないと署名で蹴られる
AWS_DEFAULT_REGION=auto

# 任意。失敗時(と成功時)に Mattermost に投げる
#MATTERMOST_WEBHOOK=https://mm.doany.io/hooks/xxxxxxxx

# 任意。scale down する namespace(既定は PVC を持つ namespace 全部から SKIP_SCALE_NAMESPACES を除いたもの)
#TARGET_NAMESPACES="..."
#SKIP_SCALE_NAMESPACES="denpa"
# 任意。保持ポリシー
#RESTIC_KEEP="--keep-daily 7 --keep-weekly 4 --keep-monthly 6"
