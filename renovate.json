{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>5ym/repo-config"
    ],
    "kubernetes": {
        "description": "kubernetes の manager は既定のファイルパターンを持たない。",
        "managerFilePatterns": [
            "**/*.yaml"
        ]
    },
    "helm-values": {
        "description": "bootstrap/ の chart の値は <name>-values.yaml という名前なので、既定のパターン(values.yaml)に足す。",
        "managerFilePatterns": [
            "/^bootstrap/[^/]+-values\\.yaml$/"
        ]
    },
    "customManagers": [
        {
            "description": "tools/Dockerfile の `# renovate:` の次の行の `ARG 名前=版`。managerFilePatterns の正規表現は `/…/` で囲む(囲まないと glob と読まれ何にも当たらない)。",
            "customType": "regex",
            "managerFilePatterns": [
                "/^tools/Dockerfile$/"
            ],
            "matchStrings": [
                "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*ARG\\s+[A-Z_]+=(?<currentValue>\\S+)"
            ]
        },
        {
            "description": "bootstrap/ の `# renovate:` の次の行の version。versions.yaml は `version: 版`、chart の <name>-values.yaml は値を邪魔しないようコメントの `# version: 版`(どちらも render.sh が読む)。",
            "customType": "regex",
            "managerFilePatterns": [
                "/^bootstrap/versions\\.yaml$/",
                "/^bootstrap/[^/]+-values\\.yaml$/"
            ],
            "matchStrings": [
                "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+registryUrl=(?<registryUrl>\\S+))?\\s*\\n\\s*(?:#\\s*)?version:\\s*(?<currentValue>\\S+)"
            ]
        },
        {
            "description": "pulumi/Pulumi.yaml の packages で包む Terraform の provider(`parameters:` の 2 つ目)。版は Terraform の registry で見る(OpenTofu の registry は Renovate が使う API を持たない)。",
            "customType": "regex",
            "managerFilePatterns": [
                "/^pulumi/Pulumi\\.yaml$/"
            ],
            "matchStrings": [
                "parameters:\\s*\\n\\s*-\\s*(?<depName>[\\w-]+/[\\w-]+)\\s*\\n\\s*-\\s*(?<currentValue>\\S+)"
            ],
            "datasourceTemplate": "terraform-provider"
        },
        {
            "description": "包む側のプラグイン。タグは v 付き、Pulumi.yaml は v なし。",
            "customType": "regex",
            "managerFilePatterns": [
                "/^pulumi/Pulumi\\.yaml$/"
            ],
            "matchStrings": [
                "source:\\s*terraform-provider\\s*\\n\\s*version:\\s*(?<currentValue>\\S+)"
            ],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "pulumi/pulumi-terraform-provider",
            "extractVersionTemplate": "^v(?<version>.+)$"
        }
    ],
    "packageRules": [
        {
            "description": "bun.lock は pulumi install で作る(SDK が file:sdks/netbird で、Renovate 自身の bun install は落ちる)。bun.lock も package file なので matchFileNames に入れる。skipArtifactsUpdate は枝の全部の更新が指定しているときだけ効くので専用の枝にする。許可は apps/renovate/renovate.yaml の RENOVATE_ALLOWED_COMMANDS。",
            "matchFileNames": [
                "pulumi/package.json",
                "pulumi/bun.lock",
                "pulumi/Pulumi.yaml"
            ],
            "skipArtifactsUpdate": true,
            "groupName": "pulumi",
            "groupSlug": "pulumi",
            "postUpgradeTasks": {
                "commands": [
                    "bash pulumi/renovate-post-upgrade.sh"
                ],
                "fileFilters": [
                    "pulumi/bun.lock",
                    "pulumi/package.json"
                ],
                "executionMode": "branch"
            }
        },
        {
            "description": "AdGuard Home は新しい版の --check-config で deployment.yaml の設定を移行して同じ枝にコミットする。専用の枝は、移行が落ちても他の PR を止めないため。",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "adguard/adguardhome"
            ],
            "groupName": "adguardhome",
            "groupSlug": "adguardhome",
            "postUpgradeTasks": {
                "commands": [
                    "bash apps/adguardhome/renovate-post-upgrade.sh"
                ],
                "fileFilters": [
                    "apps/adguardhome/deployment.yaml"
                ],
                "executionMode": "branch"
            }
        },
        {
            "description": "PostgreSQL のメジャーはタグの差し替えでは上がらない(dump と restore が要る)。",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "postgres"
            ],
            "allowedVersions": "<18"
        },
        {
            "description": "Talos・Kubernetes・Gateway API は自動マージしない(ノード 1 台で全停止、CRD は全経路が乗り換わる)。適用は人。talosctl のイメージと手元の CLI もノードの版と一緒に上げる。版の比べ方は semver にする。既定の semver-coerced は v1.15.0-alpha.1 と alpha.2 を同じ 1.15.0 とみなし、alpha・beta の更新を出さない。talosctl のイメージには開発版のタグ(v1.15.0-alpha.2-9-g567501669)もあるので、正式な版・alpha・beta・rc だけを許す。",
            "versioning": "semver",
            "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+(-(alpha|beta|rc)\\.\\d+)?$/",
            "groupName": "talos",
            "groupSlug": "talos",
            "automerge": false,
            "addLabels": [
                "needs-review"
            ],
            "matchDepNames": [
                "kubernetes/kubernetes",
                "kubernetes-sigs/gateway-api",
                "ghcr.io/siderolabs/talosctl",
                "siderolabs/talos"
            ]
        },
        {
            "description": "argo-cd と infisical の chart は自動マージしない(壊れると直す道具ごと止まる)。当てるのは render.sh → apply-config → upgrade-k8s。",
            "matchDatasources": [
                "helm"
            ],
            "matchDepNames": [
                "argo-cd",
                "infisical-standalone"
            ],
            "groupName": "bootstrap charts",
            "groupSlug": "bootstrap-charts",
            "automerge": false,
            "addLabels": [
                "needs-review"
            ]
        },
        {
            "description": "<name>-values.yaml で上書きしているイメージも chart と同じ扱い(machine config に載る)。",
            "matchDatasources": [
                "docker"
            ],
            "matchFileNames": [
                "bootstrap/argocd-values.yaml",
                "bootstrap/infisical-values.yaml"
            ],
            "groupName": "bootstrap charts",
            "groupSlug": "bootstrap-charts",
            "automerge": false,
            "addLabels": [
                "needs-review"
            ]
        },
        {
            "description": "mirror.gcr.io の tags/list は誰かが一度取った tag しか返さないので、版は Docker Hub で引く。",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "mirror.gcr.io/**"
            ],
            "overridePackageName": "{{{replace 'mirror.gcr.io/' 'docker.io/' packageName}}}"
        },
        {
            "description": "netbird のイメージは OCI ラベルが無くリリースノートが欠けるので sourceUrl を書く。サーバとクライアントは同じ PR で上げる。",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "netbirdio/netbird",
                "netbirdio/netbird-server"
            ],
            "sourceUrl": "https://github.com/netbirdio/netbird",
            "groupName": "netbird",
            "groupSlug": "netbird"
        },
        {
            "description": "NetBird の provider は自動マージしない(0.0.x で、マージが実物への up になる)。Pulumi.yaml に絞る(イメージと同名で、混ざると skipArtifactsUpdate が効かない)。",
            "matchFileNames": [
                "pulumi/Pulumi.yaml"
            ],
            "matchPackageNames": [
                "netbirdio/netbird",
                "pulumi/pulumi-terraform-provider"
            ],
            "groupName": "netbird provider",
            "groupSlug": "netbird-provider",
            "automerge": false,
            "addLabels": [
                "needs-review"
            ]
        }
    ]
}
