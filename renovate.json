{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>5ym/repo-config"
    ],
    "kubernetes": {
        "description": "kubernetes の manager は既定のファイルパターンを持たない。",
        "managerFilePatterns": [
            "**/*.yaml"
        ]
    },
    "helm-values": {
        "description": "bootstrap/ の chart の値は <name>-values.yaml(秘密を含むものは <name>-values.sops.yaml)という名前なので、既定のパターン(values.yaml)に足す。",
        "managerFilePatterns": [
            "/^bootstrap/[^/]+-values(\\.sops)?\\.yaml$/"
        ]
    },
    "customManagers": [
        {
            "description": "tools/Dockerfile の `# renovate:` の次の行の `ARG 名前=版`。managerFilePatterns の正規表現は `/…/` で囲む(囲まないと glob と読まれ何にも当たらない)。",
            "customType": "regex",
            "managerFilePatterns": [
                "/^tools/Dockerfile$/"
            ],
            "matchStrings": [
                "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*ARG\\s+[A-Z_]+=(?<currentValue>\\S+)"
            ]
        },
        {
            "description": "bootstrap/ の `# renovate:` の次の行のコメントの `# version: 版`(値を邪魔しないようコメントにしている。render.sh が読む)。Talos・Kubernetes・Gateway API は talos.sops.yaml の先頭、chart は <name>-values(.sops).yaml の先頭。SOPS のファイルは mac_only_encrypted なので平文の行を書き換えても復号できる。",
            "customType": "regex",
            "managerFilePatterns": [
                "/^bootstrap/talos\\.sops\\.yaml$/",
                "/^bootstrap/[^/]+-values(\\.sops)?\\.yaml$/"
            ],
            "matchStrings": [
                "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+registryUrl=(?<registryUrl>\\S+))?\\s*\\n\\s*(?:#\\s*)?version:\\s*(?<currentValue>\\S+)"
            ]
        },
        {
            "description": "pulumi/Pulumi.yaml の packages で包む Terraform の provider(`parameters:` の 2 つ目)。版は Terraform の registry で見る(OpenTofu の registry は Renovate が使う API を持たない)。",
            "customType": "regex",
            "managerFilePatterns": [
                "/^pulumi/Pulumi\\.yaml$/"
            ],
            "matchStrings": [
                "parameters:\\s*\\n\\s*-\\s*(?<depName>[\\w-]+/[\\w-]+)\\s*\\n\\s*-\\s*(?<currentValue>\\S+)"
            ],
            "datasourceTemplate": "terraform-provider"
        },
        {
            "description": "包む側のプラグイン。タグは v 付き、Pulumi.yaml は v なし。",
            "customType": "regex",
            "managerFilePatterns": [
                "/^pulumi/Pulumi\\.yaml$/"
            ],
            "matchStrings": [
                "source:\\s*terraform-provider\\s*\\n\\s*version:\\s*(?<currentValue>\\S+)"
            ],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "pulumi/pulumi-terraform-provider",
            "extractVersionTemplate": "^v(?<version>.+)$"
        },
        {
            "description": "CI の Pulumi CLI (pulumi.yml の pulumi-version-file)。中身は版だけ。下の pulumi のまとめに入れて SDK (@pulumi/pulumi) と同じ PR にし、pulumi install も流す (CLI を上げると bun.lock の sdks/netbird の行が変わる)。",
            "customType": "regex",
            "managerFilePatterns": [
                "/^pulumi/\\.pulumi-version$/"
            ],
            "matchStrings": [
                "^(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$"
            ],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "pulumi/pulumi",
            "extractVersionTemplate": "^v(?<version>.+)$"
        }
    ],
    "packageRules": [
        {
            "description": "bun.lock は pulumi install で作る(SDK が file:sdks/netbird で、Renovate 自身の bun install は落ちる)。bun.lock も package file なので matchFileNames に入れる。skipArtifactsUpdate は枝の全部の更新が指定しているときだけ効くので専用の枝にする。許可は apps/renovate/renovate.yaml の RENOVATE_ALLOWED_COMMANDS。",
            "matchFileNames": [
                "pulumi/package.json",
                "pulumi/bun.lock",
                "pulumi/Pulumi.yaml",
                "pulumi/.pulumi-version"
            ],
            "skipArtifactsUpdate": true,
            "groupName": "pulumi",
            "groupSlug": "pulumi",
            "postUpgradeTasks": {
                "commands": [
                    "bash pulumi/renovate-post-upgrade.sh"
                ],
                "fileFilters": [
                    "pulumi/bun.lock",
                    "pulumi/package.json"
                ],
                "executionMode": "branch"
            }
        },
        {
            "description": "AdGuard Home は新しい版の --check-config で deployment.yaml の設定を移行して同じ枝にコミットする。専用の枝は、移行が落ちても他の PR を止めないため。",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "adguard/adguardhome"
            ],
            "groupName": "adguardhome",
            "groupSlug": "adguardhome",
            "postUpgradeTasks": {
                "commands": [
                    "bash apps/adguardhome/renovate-post-upgrade.sh"
                ],
                "fileFilters": [
                    "apps/adguardhome/deployment.yaml"
                ],
                "executionMode": "branch"
            }
        },
        {
            "description": "PostgreSQL のメジャーはタグの差し替えでは上がらない(dump と restore が要る)。",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "postgres"
            ],
            "allowedVersions": "<18"
        },
        {
            "description": "Talos・Kubernetes・Gateway API は自動マージしない(ノード 1 台で全停止、CRD は全経路が乗り換わる)。適用は人。talosctl のイメージと手元の CLI、bootstrap/storage.yaml の kubectl のイメージもノードの版と一緒に上げる。版の比べ方は semver にする。既定の semver-coerced は v1.15.0-alpha.1 と alpha.2 を同じ 1.15.0 とみなし、alpha・beta の更新を出さない。talosctl のイメージには開発版のタグ(v1.15.0-alpha.2-9-g567501669)もあるので、正式な版・alpha・beta・rc だけを許す。",
            "versioning": "semver",
            "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+(-(alpha|beta|rc)\\.\\d+)?$/",
            "groupName": "talos",
            "groupSlug": "talos",
            "automerge": false,
            "addLabels": [
                "needs-review"
            ],
            "matchDepNames": [
                "kubernetes/kubernetes",
                "kubernetes-sigs/gateway-api",
                "ghcr.io/siderolabs/talosctl",
                "siderolabs/talos",
                "registry.k8s.io/kubectl"
            ]
        },
        {
            "description": "OpenEBS LVM LocalPV の chart と、bootstrap/storage.yaml の lvm-thinpool が使う同じ lvm-driver のイメージは同じ PR で上げる(LVM のコマンドを揃える)。全部の PVC の土台なので自動マージしない。当てるのは render.sh → apply-config → upgrade-k8s。",
            "matchDepNames": [
                "lvm-localpv",
                "mirror.gcr.io/openebs/lvm-driver"
            ],
            "groupName": "openebs lvm",
            "groupSlug": "openebs-lvm",
            "automerge": false,
            "addLabels": [
                "needs-review"
            ]
        },
        {
            "description": "argo-cd と infisical の chart と、その値で上書きしているイメージは自動マージしない(壊れると直す道具ごと止まる)。当てるのは render.sh → apply-config → upgrade-k8s。",
            "matchFileNames": [
                "bootstrap/argocd-values.sops.yaml",
                "bootstrap/infisical-values.sops.yaml"
            ],
            "groupName": "bootstrap charts",
            "groupSlug": "bootstrap-charts",
            "automerge": false,
            "addLabels": [
                "needs-review"
            ]
        },
        {
            "description": "mirror.gcr.io の tags/list は誰かが一度取った tag しか返さないので、版は Docker Hub で引く。",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "mirror.gcr.io/**"
            ],
            "overridePackageName": "{{{replace 'mirror.gcr.io/' 'docker.io/' packageName}}}"
        },
        {
            "description": "netbird のイメージは OCI ラベルが無くリリースノートが欠けるので sourceUrl を書く。サーバとクライアントは同じ PR で上げる。",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "netbirdio/netbird",
                "netbirdio/netbird-server"
            ],
            "sourceUrl": "https://github.com/netbirdio/netbird",
            "groupName": "netbird",
            "groupSlug": "netbird"
        },
        {
            "description": "NetBird の provider は自動マージしない(0.0.x で、マージが実物への up になる)。Pulumi.yaml に絞る(イメージと同名で、混ざると skipArtifactsUpdate が効かない)。",
            "matchFileNames": [
                "pulumi/Pulumi.yaml"
            ],
            "matchPackageNames": [
                "netbirdio/netbird",
                "pulumi/pulumi-terraform-provider"
            ],
            "groupName": "netbird provider",
            "groupSlug": "netbird-provider",
            "automerge": false,
            "addLabels": [
                "needs-review"
            ]
        }
    ]
}
